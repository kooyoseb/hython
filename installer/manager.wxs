<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Hython Manager" Manufacturer="Kooyoseb"
           Version="$(ManagerVersion)"
           UpgradeCode="{7A8560D1-47EA-4E91-B13C-8B204D41FA47}"
           Scope="perUser" Compressed="yes" Codepage="65001">
    <MajorUpgrade DowngradeErrorMessage="A newer Hython Manager version is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/kooyoseb/hython" />
    <Property Id="ARPHELPLINK" Value="https://github.com/kooyoseb/hython/issues" />
    <Icon Id="ManagerIcon" SourceFile="$(HythonIcon)" />
    <Property Id="ARPPRODUCTICON" Value="ManagerIcon" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="MANAGERFOLDER" Name="Hython Manager">
        <Component Id="ManagerExecutable" Guid="*">
          <File Id="ManagerExe" Source="$(HythonManagerExe)" KeyPath="yes" />
        </Component>
        <Component Id="ManagerUserSettingsCleanup" Guid="*">
          <RegistryValue Root="HKCU" Key="Software\Kooyoseb\Hython Manager"
                         Name="InstallerOwner" Type="integer" Value="1" KeyPath="yes" />
          <RegistryValue Root="HKCU"
                         Key="Software\Microsoft\Windows\CurrentVersion\Run"
                         Name="Hython Manager" Type="string"
                         Value="&quot;[MANAGERFOLDER]HythonManager.exe&quot; --tray" />
          <RemoveRegistryKey Root="HKCU" Key="Software\Kooyoseb\Hython Manager"
                             Action="removeOnUninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ManagerStartMenuComponent" Guid="*">
        <Shortcut Id="ManagerStartMenu" Name="Hython Manager"
                  Description="Hython 제품 설치, 업데이트 및 관리"
                  Target="[MANAGERFOLDER]HythonManager.exe"
                  WorkingDirectory="MANAGERFOLDER" Icon="ManagerIcon" />
        <RegistryValue Root="HKCU" Key="Software\Kooyoseb\HythonManager"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="ManagerDesktopComponent" Guid="*">
        <Shortcut Id="ManagerDesktop" Name="Hython Manager"
                  Description="Hython 제품 설치, 업데이트 및 관리"
                  Target="[MANAGERFOLDER]HythonManager.exe"
                  WorkingDirectory="MANAGERFOLDER" Icon="ManagerIcon" />
        <RegistryValue Root="HKCU" Key="Software\Kooyoseb\HythonManager"
                       Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="ManagerFeature" Title="Hython Manager 1.0.0" Level="1"
             AllowAbsent="no" Display="expand">
      <ComponentRef Id="ManagerExecutable" />
      <ComponentRef Id="ManagerUserSettingsCleanup" />
      <ComponentRef Id="ManagerStartMenuComponent" />
      <Feature Id="ManagerDesktopFeature" Title="Desktop shortcut"
               Description="Create a Hython Manager shortcut on the desktop." Level="2">
        <ComponentRef Id="ManagerDesktopComponent" />
      </Feature>
    </Feature>
  </Package>
</Wix>
