<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Hython" Manufacturer="Kooyoseb"
           Version="$(MsiVersion)" UpgradeCode="{18C655B5-BC7D-4C88-80B3-7F4802E8E5FA}"
           Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer Hython version is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/kooyoseb/hython" />
    <Property Id="ARPHELPLINK" Value="https://github.com/kooyoseb/hython/issues" />
    <Icon Id="HythonIcon" SourceFile="$(HythonIcon)" />
    <Property Id="ARPPRODUCTICON" Value="HythonIcon" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hython">
        <Component Id="HythonExecutable" Guid="*">
          <File Id="HythonExe" Source="$(HythonExe)" KeyPath="yes" />
        </Component>
        <Component Id="HythonUpdaterComponent" Guid="*">
          <File Id="HythonUpdaterExe" Source="$(HythonUpdaterExe)" KeyPath="yes" />
          <RegistryValue Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\Run"
                         Name="Hython Updater" Type="string"
                         Value="&quot;[INSTALLFOLDER]HythonUpdater.exe&quot;" />
        </Component>
        <Component Id="HythonPathComponent" Guid="*">
          <Environment Id="HythonPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set"
                       Part="last" System="yes" Permanent="no" />
          <RegistryValue Root="HKLM" Key="Software\Kooyoseb\Hython"
                         Name="PathFeature" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="HythonStartMenuComponent" Guid="*">
        <Shortcut Id="HythonStartMenu" Name="Hython Command Prompt"
                  Description="Open the Hython programming language"
                  Target="[INSTALLFOLDER]hython.exe" Arguments="repl"
                  WorkingDirectory="INSTALLFOLDER" Icon="HythonIcon" />
        <RegistryValue Root="HKLM" Key="Software\Kooyoseb\Hython"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="HythonDesktopComponent" Guid="*">
        <Shortcut Id="HythonDesktop" Name="Hython Command Prompt"
                  Description="Open the Hython programming language"
                  Target="[INSTALLFOLDER]hython.exe" Arguments="repl"
                  WorkingDirectory="INSTALLFOLDER" Icon="HythonIcon" />
        <RegistryValue Root="HKLM" Key="Software\Kooyoseb\Hython"
                       Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Hython Programming Language" Level="1"
             AllowAbsent="no" Display="expand">
      <ComponentRef Id="HythonExecutable" />
      <ComponentRef Id="HythonUpdaterComponent" />
      <Feature Id="PathFeature" Title="Add Hython to the system PATH"
               Description="Run hython from Command Prompt, PowerShell, and Terminal." Level="1">
        <ComponentRef Id="HythonPathComponent" />
      </Feature>
      <Feature Id="StartMenuFeature" Title="Start menu command prompt shortcut"
               Description="Create a Hython Command Prompt shortcut in the Start menu." Level="1">
        <ComponentRef Id="HythonStartMenuComponent" />
      </Feature>
      <Feature Id="DesktopFeature" Title="Desktop command prompt shortcut"
               Description="Create a Hython Command Prompt shortcut on the desktop." Level="2">
        <ComponentRef Id="HythonDesktopComponent" />
      </Feature>
    </Feature>
  </Package>
</Wix>
