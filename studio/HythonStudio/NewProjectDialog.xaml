<Window x:Class="HythonStudio.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 Hython 프로젝트" Width="520" Height="360"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#202329" Foreground="#E7E9ED">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="새 Hython 프로젝트" FontSize="24" FontWeight="SemiBold"
               Foreground="#EA5B5B" Margin="0,0,0,22" />
    <StackPanel Grid.Row="1" Margin="0,0,0,14">
      <TextBlock Text="프로젝트 이름" Foreground="#AAB0BA" Margin="0,0,0,5" />
      <TextBox x:Name="ProjectNameBox" Text="새하이썬프로젝트"
               Background="#181A1F" Foreground="#E7E9ED" BorderBrush="#40454F" Padding="8" />
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,0,14">
      <TextBlock Text="저장 위치" Foreground="#AAB0BA" Margin="0,0,0,5" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="찾아보기" Click="Browse_Click" Margin="7,0,0,0" />
        <TextBox x:Name="LocationBox" Background="#181A1F" Foreground="#E7E9ED"
                 BorderBrush="#40454F" Padding="8" />
      </DockPanel>
    </StackPanel>
    <StackPanel Grid.Row="3">
      <TextBlock Text="진입 파일" Foreground="#AAB0BA" Margin="0,0,0,5" />
      <TextBox x:Name="EntryBox" Text="main.hy" Background="#181A1F"
               Foreground="#E7E9ED" BorderBrush="#40454F" Padding="8" />
    </StackPanel>
    <TextBlock Grid.Row="4" Margin="0,17,0,0" Foreground="#838A95"
               Text="프로젝트 설정, 진입 파일, dist 폴더와 .gitignore를 생성합니다."
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="취소" Width="86" IsCancel="True" />
      <Button Content="프로젝트 생성" Width="125"
              Style="{StaticResource PrimaryButton}" Click="Create_Click" />
    </StackPanel>
  </Grid>
</Window>
