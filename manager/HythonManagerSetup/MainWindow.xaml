<Window x:Class="HythonManagerSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hython Manager Setup" Width="760" Height="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Opacity="0">
  <Border Background="#0D121B" BorderBrush="#35435A" BorderThickness="1"
          CornerRadius="16">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="9" Opacity="0.58" />
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="275" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="#141D2A" CornerRadius="16,0,0,16">
        <Grid Margin="32">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Image Source="/Resources/hython-icon.png" Width="82" Height="82"
                 HorizontalAlignment="Left" />
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Hython" Foreground="#F4F6F9" FontSize="31"
                       FontWeight="Bold" />
            <TextBlock Text="Manager" Foreground="#EE565E" FontSize="31"
                       FontWeight="Bold" Margin="0,-4,0,0" />
            <TextBlock x:Name="SideDescription"
                       Text="하이썬 생태계 전체를&#x0a;한곳에서 관리하세요."
                       Foreground="#9DA9BA" FontSize="14" LineHeight="23"
                       Margin="0,18,0,0" />
          </StackPanel>
          <TextBlock Grid.Row="2" Text="Version 1.1.1 · Kooyoseb"
                     Foreground="#637187" FontSize="11" />
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="42,28,28,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="LanguageSelector" Grid.Column="1" Width="112" Height="30"
                    SelectedIndex="0" SelectionChanged="Language_Changed">
            <ComboBoxItem Content="한국어" />
            <ComboBoxItem Content="English" />
          </ComboBox>
          <Button Grid.Column="2" Content="×" Width="34" Height="30" Padding="0"
                  Click="Close_Click" />
        </Grid>

        <StackPanel x:Name="ContentPanel" Grid.Row="1" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
          <StackPanel.RenderTransform>
            <TranslateTransform x:Name="ContentTranslate" X="28" />
          </StackPanel.RenderTransform>
          <TextBlock x:Name="Heading" Text="Hython Manager 설치"
                     Foreground="#F5F7FA" FontSize="25" FontWeight="SemiBold" />
          <TextBlock x:Name="Description" Margin="0,10,0,24"
                     Text="제품 설치와 업데이트를 관리하는 트레이 앱을 설치합니다."
                     Foreground="#9AA7BA" TextWrapping="Wrap" />
          <Border Background="#151D29" BorderBrush="#2B384C"
                  BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel>
              <TextBlock x:Name="LocationLabel" Text="설치 위치"
                         Foreground="#748298" FontSize="11" />
              <TextBlock Text="%LocalAppData%\Hython Manager"
                         Foreground="#DDE2EA" Margin="0,5,0,15" />
              <CheckBox x:Name="DesktopOption"
                        Content="바탕화면 바로가기 만들기"
                        Foreground="#DDE2EA" Cursor="Hand" />
              <TextBlock x:Name="InstallNote"
                         Text="시작 메뉴와 Windows 자동 시작이 기본 구성됩니다."
                         Foreground="#748298" FontSize="11" Margin="0,13,0,0" />
            </StackPanel>
          </Border>
          <ProgressBar x:Name="Progress" Height="4" Margin="0,22,0,0"
                       IsIndeterminate="True" Visibility="Collapsed"
                       Foreground="#E44C55" Background="#253145" />
          <TextBlock x:Name="Status" Foreground="#91A0B6" Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="RemoveButton" Content="제거" Visibility="Collapsed"
                  Click="Remove_Click" />
          <Button x:Name="MainButton" Content="설치"
                  Style="{StaticResource Primary}" Click="Main_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
