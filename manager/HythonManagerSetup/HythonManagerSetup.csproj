<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\hython.ico</ApplicationIcon>
    <AssemblyName>HythonManagerSetup</AssemblyName>
    <Version>1.1.0</Version>
    <Product>Hython Manager Setup</Product>
    <Company>Kooyoseb</Company>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\hython-icon.png"
              Link="Resources\hython-icon.png" />
    <EmbeddedResource Include="..\..\release\HythonManager-1.1.0-x64.msi"
                      LogicalName="HythonManagerInstaller.msi" />
  </ItemGroup>
</Project>
