<Application x:Class="HythonManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Page" Color="#0D1119" />
    <SolidColorBrush x:Key="Panel" Color="#151B26" />
    <SolidColorBrush x:Key="PanelHover" Color="#1B2432" />
    <SolidColorBrush x:Key="Stroke" Color="#293346" />
    <SolidColorBrush x:Key="Text" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Muted" Color="#94A0B2" />
    <SolidColorBrush x:Key="Accent" Color="#E24E55" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource Page}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="#202A39" />
      <Setter Property="BorderBrush" Value="#334158" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="8"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#2B3850" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="#546681" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#C83F49" />
      <Setter Property="BorderBrush" Value="#EF6570" />
    </Style>
  </Application.Resources>
</Application>
