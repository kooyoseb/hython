<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\hython.ico</ApplicationIcon>
    <AssemblyName>HythonManager</AssemblyName>
    <RootNamespace>HythonManager</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Hython Manager</Product>
    <Company>Kooyoseb</Company>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\hython-icon.png"
              Link="Resources\hython-icon.png" />
  </ItemGroup>
</Project>
