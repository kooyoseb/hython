<Window x:Class="HythonManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hython Manager" Width="1080" Height="720"
        MinWidth="850" MinHeight="560" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
  <Border Background="{StaticResource Page}" BorderBrush="#344158"
          BorderThickness="1" CornerRadius="14">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="62" />
        <RowDefinition Height="*" />
        <RowDefinition Height="42" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#121824" CornerRadius="14,14,0,0"
              BorderBrush="#263147" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="20,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Width="34" Height="34" Source="/Resources/hython-icon.png" />
          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Text="Hython Manager" FontWeight="SemiBold" FontSize="17" />
            <TextBlock Text="하이썬 생태계 통합 관리" Foreground="{StaticResource Muted}"
                       FontSize="11" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="—" Width="42" Height="34" Padding="0"
                    Click="Minimize_Click" />
            <Button Content="×" Width="42" Height="34" Padding="0"
                    Click="Close_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="225" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#111722" BorderBrush="#263147" BorderThickness="0,0,1,0">
          <StackPanel Margin="18,24">
            <TextBlock Text="관리" Foreground="#66748A" FontWeight="SemiBold"
                       FontSize="11" Margin="8,0,0,10" />
            <Border Background="#263248" CornerRadius="9" Padding="14,11">
              <TextBlock Text="▦  모든 제품" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="Hython" Margin="14,20,0,8" Foreground="#AAB4C3" />
            <TextBlock Text="Studio" Margin="14,8" Foreground="#AAB4C3" />
            <TextBlock Text="VS Code 확장" Margin="14,8" Foreground="#AAB4C3" />
            <Separator Margin="0,22" Background="#263147" />
            <TextBlock Text="설정" Foreground="#66748A" FontWeight="SemiBold"
                       FontSize="11" Margin="8,0,0,10" />
            <CheckBox x:Name="StartWithWindowsCheck"
                      Content="Windows 시작 시 실행"
                      Margin="8,6" Checked="Setting_Changed"
                      Unchecked="Setting_Changed" />
            <CheckBox x:Name="BackgroundChecksCheck"
                      Content="백그라운드 업데이트 확인"
                      Margin="8,6" Checked="Setting_Changed"
                      Unchecked="Setting_Changed" />
            <Button Content="설정 저장" Click="SaveSettings_Click"
                    HorizontalAlignment="Stretch" Margin="4,10" />
            <Separator Margin="0,16" Background="#263147" />
            <TextBlock Text="새 GitHub 태그가 게시되면&#x0a;지원 자산을 분석해 제품으로&#x0a;자동 등록합니다."
                       Foreground="#728096" FontSize="11" LineHeight="18" />
          </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32,26,32,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="내 Hython" FontSize="30" FontWeight="SemiBold" />
              <TextBlock Text="설치된 제품과 GitHub의 최신 릴리스를 한곳에서 관리합니다."
                         Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="모두 설치·업데이트"
                    Style="{StaticResource PrimaryButton}"
                    Click="InstallAll_Click" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="↻  새로 고침" Click="Refresh_Click"
                    VerticalAlignment="Center" />
          </Grid>

          <Border Grid.Row="1" Margin="0,24,0,18" Padding="18,13"
                  Background="#151E2C" BorderBrush="#293950"
                  BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Ellipse Width="9" Height="9" Fill="#4CD28A" Margin="0,0,12,0" />
              <TextBlock Grid.Column="1" x:Name="SummaryText"
                         Text="제품 정보를 확인하고 있습니다…" />
              <TextBlock Grid.Column="2" x:Name="LastCheckedText"
                         Foreground="{StaticResource Muted}" />
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,12" Padding="20"
                            Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Stroke}"
                            BorderThickness="1" CornerRadius="12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="54" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="11"
                                Background="#253149" VerticalAlignment="Top">
                          <TextBlock Text="H" Foreground="#F15B62" FontSize="21"
                                     FontWeight="Bold" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,20,0">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="17"
                                       FontWeight="SemiBold" />
                            <Border Margin="10,0" Padding="8,3"
                                    Background="#202B3D" CornerRadius="10">
                              <TextBlock Text="{Binding StateText}" FontSize="11"
                                         Foreground="#AFC0D9" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Description}" Margin="0,7,0,0"
                                     Foreground="{StaticResource Muted}" />
                          <TextBlock Margin="0,9,0,0" FontSize="11"
                                     Foreground="#718099">
                            <Run Text="최신 " /><Run Text="{Binding LatestVersion}" />
                            <Run Text="  ·  태그 " /><Run Text="{Binding Tag}" />
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                          <Button Content="제거" Click="Uninstall_Click"
                                  IsEnabled="{Binding CanUninstall}"
                                  Tag="{Binding}" />
                          <Button Content="복구" Click="Repair_Click"
                                  IsEnabled="{Binding CanRepair}"
                                  Tag="{Binding}" />
                          <Button Content="{Binding ActionText}"
                                  Style="{StaticResource PrimaryButton}"
                                  Click="Install_Click" Tag="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border x:Name="LoadingOverlay" Background="#D90D1119"
                    CornerRadius="12">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="◌" FontSize="42" Foreground="#E24E55"
                           HorizontalAlignment="Center">
                  <TextBlock.RenderTransform>
                    <RotateTransform x:Name="LoadingRotation" CenterX="21" CenterY="21" />
                  </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="LoadingText" Text="제품을 찾는 중…"
                           Margin="0,14,0,0" Foreground="#BEC7D5" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Row="3" Margin="0,14,0,0" Padding="14"
                  Background="#121925" BorderBrush="#29364A"
                  BorderThickness="1" CornerRadius="11">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="작업 대기열" FontWeight="SemiBold" FontSize="14" />
                <Button Grid.Column="1" Content="작업 기록 열기" Padding="10,4"
                        Click="OpenHistory_Click" />
              </Grid>
              <ProgressBar Grid.Row="1" x:Name="OverallProgress" Height="4"
                           Margin="0,8" Minimum="0" Maximum="100"
                           Foreground="#E24E55" Background="#273248" />
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="QueueList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="2,5,2,7">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="110" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProductName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding StateText}"
                                   Margin="8,0" Foreground="#AFC0D9"
                                   HorizontalAlignment="Center" />
                        <Button Grid.Column="2" Content="일시정지/재개"
                                Padding="8,3" IsEnabled="{Binding CanPause}"
                                Tag="{Binding}" Click="PauseResume_Click" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,7,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                          </Grid.ColumnDefinitions>
                          <ProgressBar Height="6" Minimum="0" Maximum="100"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Value="{Binding Progress}"
                                       Foreground="#E24E55" Background="#273248" />
                          <TextBlock Grid.Column="1" Text="{Binding Detail}"
                                     FontSize="10" Foreground="#9AA7BA"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding Detail}" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="#111722" CornerRadius="0,0,14,14"
              BorderBrush="#263147" BorderThickness="0,1,0,0">
        <Grid Margin="20,0">
          <TextBlock x:Name="StatusText" Text="준비됨" VerticalAlignment="Center"
                     Foreground="#93A0B3" />
          <TextBlock Text="Hython Manager 1.1.0 · 트레이 실행 중"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     Foreground="#66748A" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
