{
  "Hython 출력": {
    "prefix": "프린트",
    "body": [
      "프린트(${1:\"안녕하세요, Hython!\"})"
    ],
    "description": "값을 출력합니다."
  },
  "Hython 함수": {
    "prefix": "데프",
    "body": [
      "데프 ${1:함수이름}(${2:인자}):",
      "    ${0:패스}"
    ],
    "description": "Hython 함수를 정의합니다."
  },
  "Hython 클래스": {
    "prefix": "클래스",
    "body": [
      "클래스 ${1:클래스이름}:",
      "    데프 __이니트__(셀프${2:, 값}):",
      "        ${0:패스}"
    ],
    "description": "Hython 클래스를 정의합니다."
  },
  "Hython 조건문": {
    "prefix": "이프",
    "body": [
      "이프 ${1:조건}:",
      "    ${2:패스}",
      "엘스:",
      "    ${0:패스}"
    ],
    "description": "if/else 조건문을 만듭니다."
  },
  "Hython for 반복문": {
    "prefix": "포",
    "body": [
      "포 ${1:항목} 인 ${2:목록}:",
      "    ${0:패스}"
    ],
    "description": "for 반복문을 만듭니다."
  },
  "Hython while 반복문": {
    "prefix": "와일",
    "body": [
      "와일 ${1:조건}:",
      "    ${0:패스}"
    ],
    "description": "while 반복문을 만듭니다."
  },
  "Hython 예외 처리": {
    "prefix": "트라이",
    "body": [
      "트라이:",
      "    ${1:패스}",
      "익셉트 ${2:익셉션} 애즈 ${3:오류}:",
      "    ${0:패스}"
    ],
    "description": "try/except 예외 처리를 만듭니다."
  },
  "Hython 모듈 가져오기": {
    "prefix": "인폴트",
    "body": [
      "인폴트 ${1:모듈}${2: 애즈 별칭}"
    ],
    "description": "모듈을 가져옵니다."
  },
  "Hython 진입점": {
    "prefix": "메인",
    "body": [
      "데프 메인():",
      "    ${1:패스}",
      "",
      "이프 __네임__ == \"__메인__\":",
      "    메인()"
    ],
    "description": "프로그램 진입점 구조를 만듭니다."
  }
}
